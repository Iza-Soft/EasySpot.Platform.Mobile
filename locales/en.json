      "3": "3. Find EasySpot in the list of applications",
      "4": "4. Allow:",
      "4a": " • Automatic start",
      "4b": " • Working in background mode",
      "4c": " • No battery limitations",
      "5": "5. Lock the app in Recent Apps"
    },
    "footer_warning": "⚠️ Critical: Battery optimization affects background reminders",
    "footer_without": "• Without setup: Reminders work ONLY when app is open",
    "footer_with": "• With setup: Reminders work even when app is closed",
    "manufacturers": {
      "huawei": {
        "title": "📱 Instructions for Huawei:",
        "steps": {
          "1": "1. Open Settings",
          "2": "2. Battery → App Launch",
          "3": "3. Find EasySpot",
          "4": "4. Allow:",
          "4a": " • Auto-launch",
          "4b": " • Secondary launch",
          "4c": " • Lock app",
          "5": "5. Then test again"
        }
      },
      "xiaomi": {
        "title": "📱 Instructions for Xiaomi:",
        "steps": {
          "1": "1. Open Settings",
          "2": "2. Battery & Performance",
          "3": "3. App Battery Management",
          "4": "4. Select EasySpot",
          "5": "5. Choose:",
          "5a": " • No restrictions",
          "5b": " • Allow auto-start",
          "6": "6. Also lock the app in Recent apps"
        }
      },
      "oneplus": {
        "title": "📱 Instructions for OnePlus:",
        "steps": {
          "1": "1. Open Settings",
          "2": "2. Battery → Battery Optimization",
          "3": "3. Find EasySpot",
          "4": "4. Select \"Don't optimize\"",
          "5": "5. Also: Settings → Apps → EasySpot",
          "6": "6. Allow \"Auto-start\""
        }
      },
      "samsung": {
        "title": "📱 Instructions for Samsung:",
        "steps": {
          "1": "1. Open Settings",
          "2": "2. Device Care → Battery",
          "3": "3. App power management → Sleeping apps",
          "4": "4. Remove EasySpot from the list",
          "5": "5. Also: Settings → Apps → EasySpot",
          "6": "6. Battery → Select \"Unrestricted\""
        }
      },
      "default": {
        "title": "📱 Instructions for your device:",
        "steps": {
          "1": "1. Open Settings",
          "2": "2. Battery → Battery Optimization",
          "3": "3. Find EasySpot",
          "4": "4. Select \"Don't optimize\" or \"No restrictions\"",
          "5": "5. If you have an \"Auto-start\" setting, enable it"
        }
      }
    }
  },
