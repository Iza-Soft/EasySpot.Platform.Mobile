{
  "name": "easy-spot",
  "version": "2.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "android:hms": "APP_VARIANT=hms expo run:android"
  },
  "dependencies": {
    "@expo-google-fonts/onest": "^0.4.2",
    "@expo-google-fonts/unbounded": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-segmented-control/segmented-control": "^2.5.7",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "date-fns": "^4.1.0",
    "expo": "~57.0.27",
    "expo-audio": "~57.0.5",
    "expo-background-task": "~57.0.21",
    "expo-camera": "~57.0.6",
    "expo-checkbox": "~57.0.0",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.21",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.12",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.20",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-sensors": "~57.0.3",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.0",
    "expo-task-manager": "~57.0.21",
    "i18next": "^23.11.5",
    "intl-pluralrules": "^2.0.1",
    "react": "19.2.3",
    "react-i18next": "^14.1.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.0",
    "typescript": "~5.9.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ]
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-notifications",
          "expo-location",
          "expo-sensors"
        ]
      }
    }
  }
}
