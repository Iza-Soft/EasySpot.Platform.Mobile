# ── Dependencies ──────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# package-lock.json IS committed: same versions on every machine and on EAS.

# ── Expo / Metro ──────────────────────────────────────────────
.expo/
.expo-shared/
.expo-dev/
expo-env.d.ts
dist/
web-build/
.metro-health-check*
*.map
*.hbc
*.packager
$TMPDIR/react-*

# ── Native projects: generated by `npx expo prebuild` (Continuous Native
#    Generation). The source of truth is app.config.ts + plugins/ + modules/.
/android
/ios

# ── Local native modules: build output ────────────────────────
modules/*/android/build/
modules/*/android/.gradle/
modules/*/android/.cxx/
.kotlin/

# ── Android / Gradle / IntelliJ ───────────────────────────────
.gradle/
local.properties
.idea/
*.iml
captures/
output.json
*.apk
*.aab
*.ap_
*.dex
*.class

# ── Xcode ─────────────────────────────────────────────────────
xcuserdata/
DerivedData/
*.xccheckout
*.xcuserstate
*.moved-aside
*.hmap
*.ipa
*.dSYM
*.dSYM.zip

# ── Signing keys and service credentials: NEVER commit ────────
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
credentials.json
google-services.json
GoogleService-Info.plist
agconnect-services.json

# ── Environment ───────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Tests / misc ──────────────────────────────────────────────
coverage/
*.log
*.tmp
*.temp
*.swp
*.swo
*.orig.*
.vscode/
.DS_Store
*.icloud
